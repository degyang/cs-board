{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csboard.local/schemas/mountain/render-manifest.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifact_metadata"}],
  "type": "object",
  "required": ["renderer", "canvas", "fps", "clips"],
  "properties": {
    "artifact_type": {"const": "render-manifest"},
    "artifact_key": {"const": "render.manifest"},
    "renderer": {"type": "string", "minLength": 1},
    "canvas": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "fps": {"type": "integer", "minimum": 1},
    "clips": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["visual_id", "clip_path", "sha256", "duration_ms"], "properties": {"visual_id": {"$ref": "common.schema.json#/$defs/id"}, "clip_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "duration_ms": {"type": "integer", "minimum": 1}}}}
  }
}
