{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csboard.local/schemas/mountain/voice-manifest.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifact_metadata"}],
  "type": "object",
  "required": ["voices"],
  "properties": {
    "artifact_type": {"const": "voice-manifest"},
    "artifact_key": {"const": "audio.voice-manifest"},
    "voices": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["unit_id", "audio_path", "sha256", "duration_ms", "sample_rate", "channels", "tts_profile", "attempt"], "properties": {"unit_id": {"$ref": "common.schema.json#/$defs/id"}, "audio_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "duration_ms": {"type": "integer", "minimum": 1}, "sample_rate": {"type": "integer", "minimum": 8000}, "channels": {"type": "integer", "minimum": 1}, "tts_profile": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}}}}
  }
}
