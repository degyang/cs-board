{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csboard.local/schemas/mountain/av-plan.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifact_metadata"}],
  "type": "object",
  "required": ["source_text_sha256", "voice_units"],
  "properties": {
    "artifact_type": {"const": "av-plan"},
    "artifact_key": {"const": "planning.av-plan"},
    "source_text_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "voice_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "order", "source_range", "text", "visual_items"],
        "properties": {
          "unit_id": {"$ref": "common.schema.json#/$defs/id"},
          "order": {"type": "integer", "minimum": 1},
          "source_range": {"$ref": "common.schema.json#/$defs/source_range"},
          "text": {"type": "string", "minLength": 1},
          "visual_items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object", "required": ["visual_id", "order", "source_range", "text"], "properties": {"visual_id": {"$ref": "common.schema.json#/$defs/id"}, "order": {"type": "integer", "minimum": 1}, "source_range": {"$ref": "common.schema.json#/$defs/source_range"}, "text": {"type": "string", "minLength": 1}}}
          }
        }
      }
    }
  }
}
