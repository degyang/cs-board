{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csboard.local/schemas/mountain/timeline.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifact_metadata"}],
  "type": "object",
  "required": ["units"],
  "properties": {
    "artifact_type": {"const": "timeline"},
    "artifact_key": {"const": "timing.timeline"},
    "units": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["unit_id", "duration_ms", "timing_source", "alignment", "visual_timings"], "properties": {"unit_id": {"$ref": "common.schema.json#/$defs/id"}, "duration_ms": {"type": "integer", "minimum": 1}, "timing_source": {"enum": ["whisper", "equal_fallback"]}, "alignment": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["succeeded", "failed"]}, "engine": {"type": "string"}, "model": {"type": "string"}, "coverage": {"type": "number", "minimum": 0, "maximum": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "reason_code": {"type": "string"}}}, "visual_timings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["visual_id", "start_ms", "end_ms"], "properties": {"visual_id": {"$ref": "common.schema.json#/$defs/id"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}}}}}}}
  }
}
