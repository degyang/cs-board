{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csboard.local/schemas/mountain/storyboard.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifact_metadata"}],
  "type": "object",
  "required": ["visuals"],
  "properties": {
    "artifact_type": {"const": "storyboard"},
    "artifact_key": {"const": "planning.storyboard"},
    "visuals": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["visual_id", "unit_id", "prompt", "negative_prompt", "composition", "overlay_text", "style_profile"], "properties": {"visual_id": {"$ref": "common.schema.json#/$defs/id"}, "unit_id": {"$ref": "common.schema.json#/$defs/id"}, "prompt": {"type": "string", "minLength": 1}, "negative_prompt": {"type": "string"}, "composition": {"type": "string", "minLength": 1}, "overlay_text": {"type": "array"}, "style_profile": {"type": "string", "minLength": 1}}}}
  }
}
