{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csboard.local/schemas/mountain/illustration-manifest.schema.json",
  "allOf": [{"$ref": "common.schema.json#/$defs/artifact_metadata"}],
  "type": "object",
  "required": ["illustrations"],
  "properties": {
    "artifact_type": {"const": "illustration-manifest"},
    "artifact_key": {"const": "illustrations.manifest"},
    "illustrations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["visual_id", "source_image_path", "final_image_path", "sha256", "width", "height", "profile", "model", "attempt"], "properties": {"visual_id": {"$ref": "common.schema.json#/$defs/id"}, "source_image_path": {"type": "string", "minLength": 1}, "final_image_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "profile": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}}}}
  }
}
